# ---------------------------------------------------------------------------
# Heartbeat Alert Service — environment configuration
# SMTP values were taken from rcm.conf (rcm-api dev database).
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Security ---------------------------------------------------------------
# Shared secret the calling backend must send in the X-API-Key header.
HEARTBEAT_API_KEY=

# --- Monitoring rules -------------------------------------------------------
# Cron expression for the check cycle (default: every minute).
CHECK_CRON=* * * * *
# A service is declared DOWN when no heartbeat arrived for this many minutes.
DOWN_AFTER_MINUTES=5
# Resend the downtime alert every N minutes while still down (0 = alert once).
REMINDER_EVERY_MINUTES=30

# --- Email notifications ----------------------------------------------------
# Comma-separated alert recipients.
ALERT_EMAIL_RECIPIENTS=ahmedzakydev@gmail.com
ALERT_EMAIL_REPLY_TO=

# --- SMTP (from rcm.conf) ---------------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=system.alertG@givc.com.sa
SMTP_PASS=
SMTP_FROM_EMAIL=system.alertG@givc.com.sa
