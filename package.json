{
  "name": "heartbeat-alert-service",
  "version": "1.0.0",
  "description": "Receives heartbeat requests from external services and sends alert notifications when heartbeats stop arriving",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "keywords": [
    "heartbeat",
    "monitoring",
    "alerting"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "node-cron": "^4.1.1",
    "nodemailer": "^7.0.3"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
